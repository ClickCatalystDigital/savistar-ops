{
  // The North American demo's reset (interiors-erp-us.ahromlabs.com). Deploy: npx wrangler deploy -c wrangler.us.jsonc
  // Deploy from this folder: npx wrangler deploy -c wrangler.jsonc
  // It must be .jsonc: wrangler looks for wrangler.jsonc in parent folders before a local wrangler.toml.
  "name": "savistar-ops-demo-reset-us",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "account_id": "5d8cf246f656006b81d99d734e8c0f40",
  // workers.dev URL only for a manual run: POST with header x-trigger-key (TRIGGER_KEY).
  "workers_dev": true,
  // 09:00 UTC = 03:00 or 04:00 US Central, overnight for North American visitors.
  "triggers": { "crons": ["0 9 * * *"] },
  // Not secret. TURSO_API_TOKEN (Turso platform token) and TRIGGER_KEY are Worker secrets.
  "vars": { "TURSO_ORG": "pujan", "GROUP": "savdemo", "DEMO_DB": "sav-us-demo", "GOLDEN_DB": "sav-us-demo-golden", "TIME_ZONE": "America/Chicago" }
}
