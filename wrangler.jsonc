{
  // Public demo of Savistar Ops: interiors-erp.ahromlabs.com, made-up companies, sample data reset nightly
  // (workers/demo-reset-cron). The live app runs on Render from the same code (`next build`/`next start`).
  // Deploy the demo with `npm run cf:deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "savistar-ops-interiors-demo",
  "account_id": "5d8cf246f656006b81d99d734e8c0f40",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"], // public fetch: lib/demo-leads.js calls ahromlabs.com (same zone)
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "routes": [{ "pattern": "interiors-erp.ahromlabs.com", "custom_domain": true }],
  // Secrets (wrangler secret put): TURSO_AUTH_TOKEN (savdemo group token), SESSION_SECRET (its own),
  // OPENROUTER_API_KEY (the demo's own credit-capped key for the assistant; without it the assistant is hidden),
  // DEMO_PASS (the owner-pass PIN, 4+ characters; see DEMO.md).
  // Never the live deployment's values.
  "vars": {
    "DEMO_MODE": "1",
    "SKIP_MIGRATE": "1",
    "TURSO_URL": "libsql://sav-demo-pujan.aws-ap-south-1.turso.io",
    // The owner pass reads and writes golden instead, so its changes survive the nightly reset (lib/db.js).
    "GOLDEN_TURSO_URL": "libsql://sav-demo-golden-pujan.aws-ap-south-1.turso.io",
    "LEADS_TURSO_URL": "libsql://sav-demo-leads-pujan.aws-ap-south-1.turso.io"
  },
  // Run next to the database (Turso, Mumbai): a page makes several sequential queries.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true }
}
