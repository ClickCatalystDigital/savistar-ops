# Leave TURSO_URL blank to use a local SQLite file (./savistar-ops-local.db) for dev.
# Create a NEW Turso database for this app (do not reuse ls_crm's).
TURSO_URL=
TURSO_AUTH_TOKEN=

# JWT signing secret — set a long random string in production
SESSION_SECRET=change-this-in-production

# Cloudflare R2 (file attachments + bank statement PDFs) — NEW account/bucket for this company.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=savistar-ops-storage
R2_PUBLIC_DOMAIN_URL=

# OpenRouter — AI extraction of bank statement PDFs
OPENROUTER_API_KEY=
EXTRACTION_MODEL=google/gemini-2.5-flash

PORT=3000

# AI assistant (Settings → AI): encrypts the OpenRouter key saved there. 32 random bytes:
#   openssl rand -base64 32
# Without it the key can't be saved in Settings (OPENROUTER_API_KEY above is then used as the fallback).
SETTINGS_ENC_KEY=
